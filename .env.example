# BAY-E local AI (no cloud key required)
BAYE_MODEL_ORDER=llama.cpp,ollama
BAYE_LLAMA_URL=http://127.0.0.1:8080
BAYE_LLAMA_MODEL=local
BAYE_OLLAMA_URL=http://127.0.0.1:11434
BAYE_OLLAMA_MODEL=qwen2.5:3b

# Optional local audio
BAYE_WHISPER_BIN=whisper-cli
BAYE_WHISPER_MODEL=~/models/ggml-base.bin
BAYE_PIPER_BIN=piper
BAYE_PIPER_MODEL=~/models/es_ES.onnx

# Optional local object detection
BAYE_VISION_ONNX=~/models/yolov8n.onnx
BAYE_VISION_LABELS=~/models/coco.names

# Physical robot: stays disabled until explicitly enabled
BAYE_ROS2_ENABLE=0
BAYE_ROS_LINEAR=0.18
BAYE_ROS_ANGULAR=0.65
BAYE_PORT=8300
# Optional opt-in face identity (OpenCV YuNet + SFace)
BAYE_FACE_DETECTOR_ONNX=~/models/face_detection_yunet.onnx
BAYE_FACE_RECOGNIZER_ONNX=~/models/face_recognition_sface.onnx
BAYE_FACE_COSINE_THRESHOLD=0.42
