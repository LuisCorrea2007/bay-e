{
  "name": "baye-mobile",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test:url-policy && vite build",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "test:url-policy": "node scripts/test-core-url.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/motion": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@aparajita/capacitor-secure-storage": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "vite": "^7.1.0"
  }
}
